TYPESAFE_API_KEY=
# Jev public list price, 2026-09: $0.042 / 1M input, output unmetered.
TYPESAFE_INPUT_USD_PER_MTIME=0.042
TYPESAFE_OUTPUT_USD_PER_MTIME=0

OPENAI_API_KEY=
# /v1 or the full .../v1/chat/completions URL both work
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# USD per 1M tokens. Leave at 0 to still count tokens without pricing.
OPENAI_INPUT_USD_PER_MTIME=0
OPENAI_OUTPUT_USD_PER_MTIME=0
PORT=8787

# Optional local Laya process. Missing service => that column returns 503.
LAYA_URL=http://127.0.0.1:8790
# Scripts live in ./laya. Override only if you keep them elsewhere.
LAYA_HOME=
# Environment that already has the `laya` package. Defaults to ./laya/.venv
LAYA_VENV=
LAYA_MODEL=multilingual
LAYA_PRELOAD=multilingual
# macOS: cpu. mps can abort on Metal command-buffer assertions.
LAYA_DEVICE=cpu
